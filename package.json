{
  "name": "sql-log-prettifier",
  "version": "0.2.0",
  "description": "SQL query prettifier for your favorite logger",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "url": "git+https://github.com/zcuric/sql-log-prettifier.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/zcuric/sql-log-prettifier/issues"
  },
  "homepage": "https://github.com/zcuric/sql-log-prettifier#readme",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "sql",
    "logger",
    "log",
    "pretty print",
    "sequelize",
    "logging"
  ],
  "author": "Zdravko Ćurić <zcuric@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "ansis": "^4.3.1",
    "sql-formatter": "^15.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist",
    "src"
  ],
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
